@using System.Security.Claims
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Учет складских товаров</title>

    <style>
        body, html {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            height: 100%;
        }

        * {
            box-sizing: border-box;
        }

        .layout-container {
            display: flex;
            min-height: 100vh;
        }   

        /* Sidebar */
        .sidebar {

            width: 90px;
            background-color: #2c3e50;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-top: 25px;
            transition: width 0.3s ease;
            overflow: hidden;
            flex-shrink: 0;
        }

        .sidebar:hover {
            width: 250px;
        }

        .sidebar nav {
            width: 100%;
        }

        .sidebar nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
            width: 100%;
        }

        .sidebar nav ul li {
            margin: 12px 0;
            width: 100%;
        }

        .sidebar nav ul li a {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: white;
            padding: 14px 18px;
            width: 100%;
            min-height: 72px;
            transition: background-color 0.2s ease;
            overflow: hidden;
        }

        .sidebar nav ul li a:hover {
            background-color: #34495e;
        }

        .sidebar nav ul li a img {
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            display: block;
        }

        /* Подпись */
        .sidebar nav ul li a .tooltip {
            margin-left: 18px;
            font-size: 18px;
            white-space: nowrap;

            opacity: 0;
            width: 0;
            overflow: hidden;

            transition: opacity 0.2s ease, width 0.2s ease, margin-left 0.2s ease;
        }

        .sidebar:hover nav ul li a .tooltip {
            opacity: 1;
            width: 160px;
        }

        /* Main content */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            background-color: #f7f9fb;
            
        }

        /* Header */
        .header {
            position: relative;
            background-color: white;
            padding: 20px 30px;
            border-bottom: 1px solid #d9e0e6;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 80px;
        }

        .header h1 {
            margin: 0;
            font-size: 30px;
            color: #2c3e50;
        }

        main[role="main"] {
            flex: 1;
            padding: 25px 30px;
        }

        .notification-wrapper {
            position: absolute;
            right: 30px;
            top: 50%;
            margin-top: -24px; 
        }
        
        .bell-btn {
            background: #f3f4f6;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.18s ease;
        }

        .bell-btn:hover {
            background: #e5e7eb;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
        }

        .bell-btn img {
            width: 26px;
            height: 26px;
        }    </style>
</head>
<body>
<div class="layout-container">
    <!-- Sidebar -->
    <aside class="sidebar">
        <nav>
            <ul>
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a asp-controller="Admin" asp-action="Users">
                            <img src="~/images/users.png" alt="Пользователи"/>
                            <span class="tooltip">Пользователи</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Storekeeper") || User.IsInRole("Admin"))
                {
                    <li>
                        <a asp-controller="Catalog" asp-action="Providers">
                            <img src="~/images/provider.png" alt="Поставщики"/>
                            <span class="tooltip">Поставщики</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <li>
                        <a asp-controller="Catalog" asp-action="ProductRemains">
                            <img src="~/images/remains.png" alt="Остатки"/>
                            <span class="tooltip">Остатки</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Storekeeper"))
                {
                    <li>
                        <a asp-controller="Storekeeper" asp-action="SaleOperationsPage">
                            <img src="~/images/shipment.png" alt="Отгрузки на подтверждение"/>
                            <span class="tooltip">Отгрузка товаров</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Manager"))
                {
                    <li>
                        <a asp-controller="Manager" asp-action="SaleOperations">
                            <img src="~/images/sales.png" alt="Продажи"/>
                            <span class="tooltip">Продажи</span>
                        </a>
                    </li>
                }

                <li>
                    <a asp-controller="Catalog" asp-action="Products">
                        <img src="~/images/catalog.png" alt="Каталог"/>
                        <span class="tooltip">Каталог</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="Report" asp-action="Index">
                        <img src="~/images/reports.png" alt="Отчеты"/>
                        <span class="tooltip">Отчеты</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="Auth" asp-action="Logout">
                        <img src="~/images/logout.png" alt="Выйти"/>
                        <span class="tooltip">Выйти</span>
                    </a>
                </li>

            </ul>
        </nav>
    </aside>

    <!-- Main content -->
    <div class="main-content">
        <header class="header">
            <h1>Учет складских товаров</h1>

            <div class="notification-wrapper">
                <button id="bellBtn" class="bell-btn">
                    <img src="~/images/notifications.png" alt="Уведомления"/>
                </button>

                <div id="notificationContainer" style="display:none;">
                    @await Component.InvokeAsync("Notification", new { userId = int.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var result) ? result : 0 })
                </div>
            </div>
        </header>

        <main role="main">
            @RenderBody()
        </main>
    </div>
</div>
<script src="~/js/site.js"></script>
</body>
@await RenderSectionAsync("Scripts", required: false)
</html>

<script>
    const btn = document.getElementById("bellBtn");
    const container = document.getElementById("notificationContainer");

    btn.addEventListener("click", () => {
        container.style.display =
            container.style.display === "none" ? "block" : "none";
    });

    document.addEventListener("click", (e) => {
        if (!btn.contains(e.target) && !container.contains(e.target)) {
            container.style.display = "none";
        }
    });
</script>