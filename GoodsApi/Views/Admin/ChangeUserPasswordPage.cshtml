@model GoodsApi.Infrastructure.ViewModels.ChangeUserPasswordViewModel

@{
    ViewBag.Title = "Смена пароля";
    Layout = "_Layout";
}

<head>
    <style>
        .password-page {
            max-width: 700px;
            margin: 40px auto;
            padding: 0 20px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: #1f2937;
        }

        .password-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .password-header-left h2 {
            margin: 0;
            font-size: 32px;
            font-weight: 700;
            color: #111827;
        }

        .password-header-left p {
            margin-top: 8px;
            font-size: 15px;
            color: #6b7280;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 120px;
            height: 46px;
            padding: 0 18px;
            border-radius: 14px;
            background: #f3f4f6;
            color: #111827;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            border: 1px solid #e5e7eb;
            transition: all 0.18s ease;
        }

        .back-btn:hover {
            background: #e5e7eb;
            transform: translateY(-2px);
        }

        .password-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 24px;
            padding: 32px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
        }

        .password-form {
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        .section-title {
            margin: 0 0 18px 0;
            font-size: 18px;
            font-weight: 700;
            color: #111827;
        }

        .user-meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .meta-card {
            padding: 16px 18px;
            border-radius: 16px;
            background: #f9fafb;
            border: 1px solid #f3f4f6;
        }

        .meta-title {
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 6px;
        }

        .meta-value {
            font-size: 15px;
            font-weight: 600;
            color: #111827;
            word-break: break-word;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 22px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-label {
            font-size: 14px;
            font-weight: 600;
            color: #374151;
        }

        .form-input {
            width: 100%;
            min-height: 50px;
            padding: 0 16px;
            border: 1px solid #d1d5db;
            border-radius: 14px;
            font-size: 15px;
            color: #111827;
            background: #ffffff;
            transition: border-color 0.18s ease, box-shadow 0.18s ease;
            box-sizing: border-box;
        }

        .form-input:focus {
            outline: none;
            border-color: #ea580c;
            box-shadow: 0 0 0 4px rgba(234, 88, 12, 0.10);
        }

        .form-hint {
            font-size: 13px;
            color: #6b7280;
            margin-top: -2px;
        }

        .warning-box {
            padding: 16px 18px;
            border-radius: 16px;
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: #9a3412;
            font-size: 14px;
            line-height: 1.55;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 14px;
            margin-top: 4px;
            flex-wrap: wrap;
        }

        .secondary-btn,
        .primary-btn {
            min-width: 170px;
            height: 50px;
            border-radius: 16px;
            border: none;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.18s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 20px;
        }

        .secondary-btn {
            background: #f3f4f6;
            color: #111827;
            border: 1px solid #e5e7eb;
        }

        .secondary-btn:hover {
            background: #e5e7eb;
            transform: translateY(-2px);
        }

        .primary-btn {
            background: #c2410c;
            color: #ffffff;
            box-shadow: 0 10px 24px rgba(194, 65, 12, 0.18);
        }

        .primary-btn:hover {
            background: #9a3412;
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(194, 65, 12, 0.24);
        }

        .validation-summary-errors {
            padding: 14px 16px;
            border-radius: 14px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            font-size: 14px;
        }

        .field-validation-error {
            font-size: 13px;
            color: #b91c1c;
            margin-top: 2px;
        }

        @@media (max-width: 768px) {
            .password-page {
                margin: 24px auto;
                padding: 0 14px;
            }

            .password-header-left h2 {
                font-size: 26px;
            }

            .password-card {
                padding: 22px;
                border-radius: 20px;
            }

            .user-meta {
                grid-template-columns: 1fr;
            }

            .form-actions {
                flex-direction: column-reverse;
            }

            .secondary-btn,
            .primary-btn,
            .back-btn {
                width: 100%;
            }
        }
    </style>
</head>

<div class="password-page">
    <div class="password-header">
        <div class="password-header-left">
            <h2>Смена пароля</h2>
            <p>Задайте новый пароль для выбранного пользователя.</p>
        </div>

        <a asp-controller="Admin"
           asp-action="UserEditPage"
           asp-route-id="@Model.UserId"
           class="back-btn">
            Назад
        </a>
    </div>

    <div class="password-card">
        <form asp-controller="Admin"
              asp-action="ChangeUserPassword"
              method="post"
              class="password-form">

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Username" />

            <div asp-validation-summary="ModelOnly"></div>

            <div>
                <h3 class="section-title">Пользователь</h3>

                <div class="user-meta">
                    <div class="meta-card">
                        <div class="meta-title">ID пользователя</div>
                        <div class="meta-value">@Model.UserId</div>
                    </div>

                    <div class="meta-card">
                        <div class="meta-title">Имя пользователя</div>
                        <div class="meta-value">@Model.Username</div>
                    </div>
                </div>
            </div>

            <div>
                <h3 class="section-title">Новый пароль</h3>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                        <input asp-for="NewPassword"
                               class="form-input"
                               type="password"
                               placeholder="Введите новый пароль" />
                        <span asp-validation-for="NewPassword"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label">Подтверждение пароля</label>
                        <input asp-for="ConfirmPassword"
                               class="form-input"
                               type="password"
                               placeholder="Повторите новый пароль" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>
            </div>

            <div class="warning-box">
                После сохранения старый пароль пользователя перестанет действовать.
            </div>

            <div class="form-actions">
                <a asp-controller="Admin"
                   asp-action="UserEditPage"
                   asp-route-id="@Model.UserId"
                   class="secondary-btn">
                    Отмена
                </a>

                <button type="submit" class="primary-btn">
                    Сменить пароль
                </button>
            </div>
        </form>
    </div>
</div>
