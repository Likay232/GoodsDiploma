@model System.Collections.Generic.List<GoodsApi.Infrastructure.Models.DTO.User>

@{
    ViewBag.Title = "Пользователи";
    Layout = "_Layout";
}

<head>
    <style>
        .users-page {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: #1f2937;
        }

        .users-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .users-header-left h2 {
            margin: 0;
            font-size: 32px;
            font-weight: 700;
            color: #111827;
        }

        .users-header-left p {
            margin-top: 8px;
            font-size: 15px;
            color: #6b7280;
        }

        .add-user-btn {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            border: none;
            background: #111827;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 24px rgba(17, 24, 39, 0.18);
            cursor: pointer;
            transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
            text-decoration: none;
            flex-shrink: 0;
        }

        .add-user-btn:hover {
            transform: translateY(-2px);
            background: #1f2937;
            box-shadow: 0 14px 28px rgba(17, 24, 39, 0.24);
        }

        .add-user-btn img {
            width: 24px;
            height: 24px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }

        .users-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 24px;
        }

        .user-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
            transition: transform 0.18s ease, box-shadow 0.18s ease;
            position: relative;
        }

        .user-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 32px rgba(0, 0, 0, 0.08);
        }

        .card-actions {
            position: absolute;
            top: 18px;
            right: 18px;
            display: flex;
            gap: 10px;
        }

        .icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            background: #f9fafb;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.18s ease;
            text-decoration: none;
            padding: 0;
        }

        .icon-btn:hover {
            transform: translateY(-2px);
            background: #f3f4f6;
            border-color: #d1d5db;
        }

        .icon-btn img {
            width: 18px;
            height: 18px;
            object-fit: contain;
        }

        .delete-btn {
            border: none;
        }

        .delete-btn:hover {
            background: #fef2f2;
            border-color: #fecaca;
        }

        .edit-btn:hover {
            background: #eff6ff;
            border-color: #bfdbfe;
        }

        .user-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 18px;
            padding-right: 100px;
        }

        .user-main-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .user-name {
            font-size: 21px;
            font-weight: 700;
            color: #111827;
            word-break: break-word;
        }

        .user-id {
            font-size: 13px;
            color: #9ca3af;
        }

        .badge-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: flex-end;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .badge-role {
            background: #eef2ff;
            color: #4338ca;
        }

        .badge-active {
            background: #ecfdf5;
            color: #047857;
        }

        .badge-blocked {
            background: #fef2f2;
            color: #b91c1c;
        }

        .user-details {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-top: 10px;
        }

        .detail-row {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 12px 14px;
            background: #f9fafb;
            border-radius: 12px;
            border: 1px solid #f3f4f6;
        }

        .detail-label {
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .detail-value {
            font-size: 15px;
            font-weight: 500;
            color: #111827;
            word-break: break-word;
        }

        .empty-state {
            margin-top: 30px;
            padding: 40px 20px;
            text-align: center;
            background: #ffffff;
            border: 1px dashed #d1d5db;
            border-radius: 18px;
            color: #6b7280;
            font-size: 16px;
        }

        @@media (max-width: 640px) {
            .users-page {
                margin: 24px auto;
                padding: 0 14px;
            }

            .users-header-left h2 {
                font-size: 26px;
            }

            .user-card {
                padding: 18px;
            }

            .user-card-top {
                flex-direction: column;
                align-items: flex-start;
                padding-right: 0;
                margin-top: 36px;
            }

            .badge-group {
                justify-content: flex-start;
            }

            .card-actions {
                top: 14px;
                right: 14px;
            }
        }
    </style>
</head>

<div class="users-page">
    <div class="users-header">
        <div class="users-header-left">
            <h2>Список пользователей</h2>
            <p>Всего пользователей: <strong>@Model.Count</strong></p>
        </div>

        <a asp-controller="Admin"
           asp-action="UserEditPage"
           asp-route-id="0"
           class="add-user-btn"
           title="Добавить пользователя">
            <img src="~/images/add.svg" alt="Добавить"/>
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            Пользователи не найдены.
        </div>
    }
    else
    {
        <div class="users-grid">
            @foreach (var user in Model)
            {
                <div class="user-card" id="user-card-@user.Id">
                    <div class="card-actions">
                        <a asp-controller="Admin"
                           asp-action="UserEditPage"
                           asp-route-id="@user.Id"
                           class="icon-btn edit-btn"
                           title="Редактировать">
                            <img src="~/images/edit.svg" alt="Редактировать"/>
                        </a>

                        <button type="button"
                                class="icon-btn delete-btn"
                                title="Удалить"
                                onclick="deleteUser(@user.Id, '@user.Username')">
                            <img src="~/images/delete.svg" alt="Удалить"/>
                        </button>
                    </div>

                    <div class="user-card-top">
                        <div class="user-main-info">
                            <div class="user-name">@user.Username</div>
                        </div>

                        <div class="badge-group">
                            <span class="badge badge-role">@user.RoleName</span>

                            @if (user.IsBlocked)
                            {
                                <span class="badge badge-blocked">Заблокирован</span>
                            }
                            else
                            {
                                <span class="badge badge-active">Активен</span>
                            }
                        </div>
                    </div>

                    <div class="user-details">
                        <div class="detail-row">
                            <div class="detail-label">Email</div>
                            <div class="detail-value">@user.Email</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Дата регистрации</div>
                            <div class="detail-value">@user.RegisteredAt.ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    async function deleteUser(userId, username) {
        const confirmed = confirm(`Удалить пользователя "${username}"?`);
        if (!confirmed) return;

        try {
            const response = await fetch(`/Admin/DeleteUser?userId=${userId}`, {
                method: 'POST'
            });

            if (response.ok) {
                const card = document.getElementById(`user-card-${userId}`);
                if (card) {
                    card.remove();
                }

                const countElement = document.querySelector('.users-header-left p strong');
                if (countElement) {
                    const currentCount = parseInt(countElement.textContent);
                    if (!isNaN(currentCount) && currentCount > 0) {
                        countElement.textContent = currentCount - 1;
                    }
                }

                if (document.querySelectorAll('.user-card').length === 0) {
                    location.reload();
                }
            } else {
                alert('Не удалось удалить пользователя.');
            }
        } catch (error) {
            console.error(error);
            alert('Ошибка при удалении пользователя.');
        }
    }
</script>