@model GoodsApi.Infrastructure.ViewModels.InventorizationRegistrationViewModel

@{
    ViewBag.Title = "Инвентаризация";
    Layout = "_Layout";

    var systemAmount = Model.ProductInfo?.Amount ?? 0;
    var defaultDate = Model.InventoryOperationDate == default ? DateTime.Now : Model.InventoryOperationDate;
}

<head>
    <style>
        .inventory-page {
            max-width: 1000px;
            margin: 40px auto;
            padding: 0 20px 40px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: #1f2937;
        }

        .inventory-header {
            margin-bottom: 28px;
        }

        .inventory-header h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
            color: #111827;
        }

        .inventory-header p {
            margin-top: 10px;
            font-size: 15px;
            color: #6b7280;
            line-height: 1.6;
        }

        .inventory-layout {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .info-card,
        .form-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 28px;
            padding: 28px;
            box-shadow: 0 14px 34px rgba(0, 0, 0, 0.05);
        }

        .product-info-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .product-title-block {
            min-width: 0;
            flex: 1;
        }

        .product-title {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            color: #111827;
            line-height: 1.25;
            word-break: break-word;
        }

        .product-subtitle {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .meta-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 14px;
            border-radius: 999px;
            background: #f9fafb;
            color: #4b5563;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid #e5e7eb;
        }

        .system-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 10px 16px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            color: #1d4ed8;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
        }

        .info-block {
            padding: 16px 18px;
            border-radius: 20px;
            background: #f9fafb;
            border: 1px solid #f3f4f6;
        }

        .info-label {
            font-size: 12px;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 8px;
        }

        .info-value {
            font-size: 17px;
            font-weight: 700;
            color: #111827;
            word-break: break-word;
            line-height: 1.45;
        }

        .form-title {
            margin: 0 0 24px 0;
            font-size: 24px;
            font-weight: 700;
            color: #111827;
        }

        .inventory-note {
            margin-bottom: 24px;
            padding: 16px 18px;
            border-radius: 20px;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1d4ed8;
            font-size: 14px;
            line-height: 1.7;
            font-weight: 600;
        }

        .inventory-form {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 22px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-label {
            font-size: 13px;
            font-weight: 700;
            color: #374151;
            letter-spacing: 0.02em;
        }

        .form-input {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 16px;
            padding: 14px 16px;
            font-size: 15px;
            color: #111827;
            background: #ffffff;
            outline: none;
            transition: border-color 0.18s ease, box-shadow 0.18s ease;
            box-sizing: border-box;
        }

        .form-input:focus {
            border-color: #111827;
            box-shadow: 0 0 0 4px rgba(17, 24, 39, 0.06);
        }

        .form-input.readonly {
            background: #f9fafb;
            color: #374151;
            font-weight: 700;
            cursor: not-allowed;
        }

        .field-hint {
            font-size: 12px;
            color: #6b7280;
            line-height: 1.5;
        }

        .readonly-note {
            padding: 14px 16px;
            border-radius: 18px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            font-size: 14px;
            color: #4b5563;
            line-height: 1.6;
        }

        .summary-box {
            margin-top: 26px;
            padding: 18px 20px;
            border-radius: 22px;
            border: 1px solid #e5e7eb;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            transition: all 0.18s ease;
        }

        .summary-neutral {
            background: #f9fafb;
        }

        .summary-good {
            background: #ecfdf5;
            border-color: #a7f3d0;
        }

        .summary-warning {
            background: #fffbeb;
            border-color: #fde68a;
        }

        .summary-danger {
            background: #fef2f2;
            border-color: #fecaca;
        }

        .summary-title {
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #6b7280;
        }

        .summary-value {
            font-size: 26px;
            font-weight: 800;
            color: #111827;
        }

        .validation-text {
            font-size: 13px;
            color: #dc2626;
            font-weight: 600;
        }

        .validation-summary-errors {
            margin-bottom: 22px;
            padding: 16px 18px;
            border-radius: 18px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            font-size: 14px;
            font-weight: 600;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

        .form-actions {
            margin-top: 30px;
            display: flex;
            justify-content: flex-end;
            gap: 14px;
            flex-wrap: wrap;
        }

        .secondary-btn,
        .primary-btn {
            min-width: 180px;
            height: 48px;
            padding: 0 22px;
            border-radius: 16px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.18s ease;
            cursor: pointer;
            border: none;
        }

        .secondary-btn {
            background: #f3f4f6;
            color: #111827;
            border: 1px solid #e5e7eb;
        }

        .secondary-btn:hover {
            background: #e5e7eb;
            transform: translateY(-2px);
        }

        .primary-btn {
            background: #111827;
            color: #ffffff;
            box-shadow: 0 12px 24px rgba(17, 24, 39, 0.16);
        }

        .primary-btn:hover {
            background: #1f2937;
            transform: translateY(-2px);
            box-shadow: 0 16px 30px rgba(17, 24, 39, 0.22);
        }

        @@media (max-width: 992px) {
            .info-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .inventory-page {
                margin: 24px auto;
                padding: 0 14px 30px;
            }

            .inventory-header h2 {
                font-size: 28px;
            }

            .info-card,
            .form-card {
                padding: 22px 18px;
                border-radius: 22px;
            }

            .product-title {
                font-size: 24px;
            }

            .info-grid,
            .inventory-form {
                grid-template-columns: 1fr;
            }

            .summary-box {
                flex-direction: column;
                align-items: flex-start;
            }

            .form-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .secondary-btn,
            .primary-btn {
                width: 100%;
            }
        }
    </style>
</head>

<div class="inventory-page">
    <div class="inventory-header">
        <h2>Инвентаризация</h2>
        <p>Сверка фактического количества товара с данными складской системы.</p>
    </div>

    <div class="inventory-layout">
        <div class="info-card">
            <div class="product-info-top">
                <div class="product-title-block">
                    <h3 class="product-title">Данные о товаре</h3>

                    <div class="product-subtitle">
                        <span class="meta-badge">Артикул: @Model.ProductInfo.Article</span>
                    </div>
                </div>

                <span class="system-badge">
                    Учётный остаток: @Model.ProductInfo.Amount
                </span>
            </div>

            <div class="info-grid">
                <div class="info-block">
                    <div class="info-label">Цена</div>
                    <div class="info-value">@Model.ProductInfo.Price</div>
                </div>

                <div class="info-block">
                    <div class="info-label">Размер</div>
                    <div class="info-value">@Model.ProductInfo.Size</div>
                </div>

                <div class="info-block">
                    <div class="info-label">Цвет</div>
                    <div class="info-value">@Model.ProductInfo.Color</div>
                </div>

                <div class="info-block">
                    <div class="info-label">Количество в системе</div>
                    <div class="info-value">@Model.ProductInfo.Amount</div>
                </div>

                <div class="info-block" style="grid-column: 1 / -1;">
                    <div class="info-label">Расположение</div>
                    <div class="info-value">@Model.ProductInfo.Location</div>
                </div>
            </div>
        </div>

        <div class="form-card">
            <h3 class="form-title">Данные об остатках на складе</h3>

            <div class="inventory-note">
                Укажите фактическое количество товара, обнаруженное при проверке.
                Расхождение будет рассчитано автоматически.
            </div>

            <form asp-controller="Storekeeper"
                  asp-action="RegisterInventorizationOperation"
                  method="post">

                <input asp-for="ProductInfo.Id" type="hidden" />
                <input asp-for="ProductInfo.ProductId" type="hidden" />
                <input asp-for="ProductInfo.Article" type="hidden" />
                <input asp-for="ProductInfo.Price" type="hidden" />
                <input asp-for="ProductInfo.Size" type="hidden" />
                <input asp-for="ProductInfo.Color" type="hidden" />
                <input asp-for="ProductInfo.Amount" type="hidden" />
                <input asp-for="ProductInfo.Location" type="hidden" />
                <input asp-for="UserId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="inventory-form">
                    <div class="form-group">
                        <label asp-for="FactAmount" class="form-label">Фактическое количество</label>
                        <input asp-for="FactAmount"
                               class="form-input"
                               type="number"
                               min="0"
                               placeholder="Введите фактический остаток" />
                        <span class="field-hint">Введите фактическое количество товара, найденное на складе.</span>
                        <span asp-validation-for="FactAmount" class="validation-text"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MismatchAmount" class="form-label">Расхождение</label>
                        <input asp-for="MismatchAmount"
                               class="form-input readonly"
                               type="number"
                               readonly />
                        <span class="field-hint">Рассчитывается как: фактическое количество − учётное количество.</span>
                        <span asp-validation-for="MismatchAmount" class="validation-text"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="InventoryOperationDate" class="form-label">Дата и время проведения инвентаризации</label>
                        <input asp-for="InventoryOperationDate"
                               class="form-input"
                               type="datetime-local"
                               value="@defaultDate.ToString("yyyy-MM-ddTHH:mm")" />
                        <span class="field-hint">Укажите фактическое время проведения инвентаризации.</span>
                        <span asp-validation-for="InventoryOperationDate" class="validation-text"></span>
                    </div>

                    <div class="form-group full-width">
                        <div class="readonly-note">
                            Если будет обнаружено расхождение, данные можно будет использовать для корректировки складских остатков и последующего анализа.
                        </div>
                    </div>
                </div>

                <div class="summary-box summary-neutral" id="inventorySummaryBox">
                    <div>
                        <div class="summary-title">Результат сверки</div>
                        <div class="field-hint" id="inventorySummaryHint">
                            Введите фактическое количество для анализа результата.
                        </div>
                    </div>

                    <div class="summary-value" id="inventorySummaryValue">0</div>
                </div>

                <div class="form-actions">
                    <a asp-controller="Catalog"
                       asp-action="ProductInfos"
                       asp-route-productId="@Model.ProductInfo.ProductId"
                       class="secondary-btn">
                        Назад
                    </a>

                    <button type="submit" class="primary-btn">
                        Сохранить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const factInput = document.getElementById("FactAmount");
            const mismatchInput = document.getElementById("MismatchAmount");
            const summaryBox = document.getElementById("inventorySummaryBox");
            const summaryHint = document.getElementById("inventorySummaryHint");
            const summaryValue = document.getElementById("inventorySummaryValue");

            const systemAmount = @systemAmount;

            function updateMismatch() {
                const fact = parseInt(factInput?.value || 0);
                const mismatch = fact - systemAmount;

                if (mismatchInput) {
                    mismatchInput.value = isNaN(mismatch) ? 0 : mismatch;
                }

                summaryBox.classList.remove("summary-neutral", "summary-good", "summary-warning", "summary-danger");

                if (isNaN(mismatch)) {
                    summaryBox.classList.add("summary-neutral");
                    summaryValue.textContent = "0";
                    summaryHint.textContent = "Введите фактическое количество для анализа результата.";
                    return;
                }

                summaryValue.textContent = mismatch;

                if (mismatch === 0) {
                    summaryBox.classList.add("summary-good");
                    summaryHint.textContent = "Расхождений не обнаружено. Учётный остаток совпадает с фактическим.";
                } else if (mismatch > 0) {
                    summaryBox.classList.add("summary-warning");
                    summaryHint.textContent = "На складе обнаружено больше товара, чем числится в системе.";
                } else {
                    summaryBox.classList.add("summary-danger");
                    summaryHint.textContent = "На складе обнаружено меньше товара, чем числится в системе.";
                }
            }

            if (factInput) {
                factInput.addEventListener("input", updateMismatch);
            }

            updateMismatch();
        })();
    </script>
}