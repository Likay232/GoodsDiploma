@{
    ViewBag.Title = "Отчеты";
    Layout = "_Layout";
}

<head>
    <style>
        .reports-page {
            max-width: 1300px;
            margin: 40px auto;
            padding: 0 20px 40px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: #1f2937;
        }

        .reports-header {
            margin-bottom: 32px;
        }

        .reports-header h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
            color: #111827;
        }

        .reports-header p {
            margin-top: 10px;
            font-size: 15px;
            color: #6b7280;
        }

        .reports-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 22px;
        }

        .report-card {
            background: #ffffff;
            border-radius: 28px;
            padding: 26px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04);
            display: flex;
            flex-direction: column;
            gap: 18px;
            transition: all 0.18s ease;
            min-height: 260px;
        }

        .report-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 36px rgba(0, 0, 0, 0.07);
            border-color: #d1d5db;
        }

        .report-title {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
        }

        .report-description {
            font-size: 14px;
            color: #6b7280;
            line-height: 1.6;
        }

        .report-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .meta-badge {
            padding: 6px 12px;
            border-radius: 999px;
            background: #f3f4f6;
            font-size: 12px;
            font-weight: 600;
            color: #374151;
        }

        .report-actions {
            margin-top: auto;
        }

        .report-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 44px;
            padding: 0 18px;
            border-radius: 14px;
            background: #111827;
            color: #ffffff;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            transition: all 0.18s ease;
            box-shadow: 0 10px 22px rgba(17, 24, 39, 0.14);
        }

        .report-btn:hover {
            background: #1f2937;
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(17, 24, 39, 0.20);
        }

        @@media (max-width: 768px) {
            .reports-page {
                margin: 24px auto;
                padding: 0 14px 30px;
            }

            .reports-header h2 {
                font-size: 28px;
            }
        }
    </style>
</head>

<div class="reports-page">

    <div class="reports-header">
        <h2>Отчеты</h2>
        <p>Анализ складских операций, остатков и продаж товаров.</p>
    </div>

    <div class="reports-grid">

        <!-- Остатки -->
        @if (User.IsInRole("Admin") || User.IsInRole("Storekeeper"))
        {
            <div class="report-card">
                <div class="report-title">Остатки товаров</div>

                <div class="report-description">
                    Текущее состояние склада с детализацией по характеристикам товара и контролем минимальных остатков.
                </div>

                <div class="report-actions">
                    <a asp-controller="Report"
                       asp-action="RemainsReport"
                       class="report-btn">
                        Открыть отчет
                    </a>
                </div>
            </div>
        }

        <!-- Движение -->
        @if (User.IsInRole("Admin") || User.IsInRole("Storekeeper"))
        {
            <div class="report-card">
                <div class="report-title">Движение товаров</div>

                <div class="report-description">
                    Все операции: поступления, продажи, списания и перемещения за выбранный период.
                </div>

                <div class="report-actions">
                    <a asp-controller="Report"
                       asp-action="ProductMovementsReport"
                       class="report-btn">
                        Открыть отчет
                    </a>
                </div>
            </div>
        }

        <!-- Продажи -->
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <div class="report-card">
                <div class="report-title">Продажи</div>

                <div class="report-description">
                    Анализ реализованных товаров, выручки и эффективности продаж с визуализацией данных.
                </div>

                <div class="report-actions">
                    <a asp-controller="Report"
                       asp-action="SalesReport"
                       class="report-btn">
                        Открыть отчет
                    </a>
                </div>
            </div>
        }

        <!-- Поставки -->
        @if (User.IsInRole("Admin") || User.IsInRole("Storekeeper"))
        {
            <div class="report-card">
                <div class="report-title">Поставки товаров</div>

                <div class="report-description">
                    Учет поступлений от поставщиков с анализом объемов закупок и стоимости.
                </div>

                <div class="report-actions">
                    <a asp-controller="Report"
                       asp-action="DeliveriesReport"
                       class="report-btn">
                        Открыть отчет
                    </a>
                </div>
            </div>
        }
    </div>

</div>