@model GoodsApi.Infrastructure.ViewModels.SaleRegistrationViewModel

@{
    ViewBag.Title = "Регистрация продажи";
    Layout = "_Layout";

    var availableAmount = Model.ProductInfo?.Amount ?? 0;
    var defaultDate = Model.SaleDate == default ? DateTime.Now : Model.SaleDate;
}

<head>
    <style>
        .sale-page {
            max-width: 1000px;
            margin: 40px auto;
            padding: 0 20px 40px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: #1f2937;
        }

        .sale-header {
            margin-bottom: 28px;
        }

        .sale-header h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
            color: #111827;
        }

        .sale-header p {
            margin-top: 10px;
            font-size: 15px;
            color: #6b7280;
            line-height: 1.6;
        }

        .sale-layout {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .info-card,
        .form-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 28px;
            padding: 28px;
            box-shadow: 0 14px 34px rgba(0, 0, 0, 0.05);
        }

        .product-info-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .product-title-block {
            min-width: 0;
            flex: 1;
        }

        .product-title {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            color: #111827;
            line-height: 1.25;
            word-break: break-word;
        }

        .product-subtitle {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .meta-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 14px;
            border-radius: 999px;
            background: #f9fafb;
            color: #4b5563;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid #e5e7eb;
        }

        .stock-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 10px 16px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
            border: 1px solid transparent;
        }

        .stock-good {
            background: #ecfdf5;
            color: #047857;
            border-color: #a7f3d0;
        }

        .stock-low {
            background: #fffbeb;
            color: #b45309;
            border-color: #fde68a;
        }

        .stock-empty {
            background: #fef2f2;
            color: #b91c1c;
            border-color: #fecaca;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
        }

        .info-block {
            padding: 16px 18px;
            border-radius: 20px;
            background: #f9fafb;
            border: 1px solid #f3f4f6;
        }

        .info-label {
            font-size: 12px;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 8px;
        }

        .info-value {
            font-size: 17px;
            font-weight: 700;
            color: #111827;
            word-break: break-word;
            line-height: 1.45;
        }

        .form-title {
            margin: 0 0 24px 0;
            font-size: 24px;
            font-weight: 700;
            color: #111827;
        }

        .sale-form {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 22px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-label {
            font-size: 13px;
            font-weight: 700;
            color: #374151;
            letter-spacing: 0.02em;
        }

        .form-input {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 16px;
            padding: 14px 16px;
            font-size: 15px;
            color: #111827;
            background: #ffffff;
            outline: none;
            transition: border-color 0.18s ease, box-shadow 0.18s ease;
            box-sizing: border-box;
        }

        .form-input:focus {
            border-color: #111827;
            box-shadow: 0 0 0 4px rgba(17, 24, 39, 0.06);
        }

        .field-hint {
            font-size: 12px;
            color: #6b7280;
            line-height: 1.5;
        }

        .readonly-note {
            padding: 14px 16px;
            border-radius: 18px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            font-size: 14px;
            color: #4b5563;
            line-height: 1.6;
        }

        .summary-box {
            margin-top: 26px;
            padding: 18px 20px;
            border-radius: 22px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .summary-title {
            font-size: 14px;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .summary-value {
            font-size: 26px;
            font-weight: 800;
            color: #111827;
        }

        .validation-text {
            font-size: 13px;
            color: #dc2626;
            font-weight: 600;
        }

        .validation-summary-errors {
            margin-bottom: 22px;
            padding: 16px 18px;
            border-radius: 18px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            font-size: 14px;
            font-weight: 600;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

        .form-actions {
            margin-top: 30px;
            display: flex;
            justify-content: flex-end;
            gap: 14px;
            flex-wrap: wrap;
        }

        .secondary-btn,
        .primary-btn {
            min-width: 180px;
            height: 48px;
            padding: 0 22px;
            border-radius: 16px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.18s ease;
            cursor: pointer;
            border: none;
        }

        .secondary-btn {
            background: #f3f4f6;
            color: #111827;
            border: 1px solid #e5e7eb;
        }

        .secondary-btn:hover {
            background: #e5e7eb;
            transform: translateY(-2px);
        }

        .primary-btn {
            background: #111827;
            color: #ffffff;
            box-shadow: 0 12px 24px rgba(17, 24, 39, 0.16);
        }

        .primary-btn:hover {
            background: #1f2937;
            transform: translateY(-2px);
            box-shadow: 0 16px 30px rgba(17, 24, 39, 0.22);
        }

        .primary-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        @@media (max-width: 992px) {
            .info-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .sale-page {
                margin: 24px auto;
                padding: 0 14px 30px;
            }

            .sale-header h2 {
                font-size: 28px;
            }

            .info-card,
            .form-card {
                padding: 22px 18px;
                border-radius: 22px;
            }

            .product-title {
                font-size: 24px;
            }

            .info-grid,
            .sale-form {
                grid-template-columns: 1fr;
            }

            .summary-box {
                flex-direction: column;
                align-items: flex-start;
            }

            .form-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .secondary-btn,
            .primary-btn {
                width: 100%;
            }
        }
    </style>
</head>

<div class="sale-page">
    <div class="sale-header">
        <h2>Регистрация продажи</h2>
        <p>Оформите продажу конкретного товара со склада.</p>
    </div>

    <div class="sale-layout">
        @{
            var stockClass = availableAmount <= 0
                ? "stock-empty"
                : availableAmount <= 5
                    ? "stock-low"
                    : "stock-good";

            var stockText = availableAmount <= 0
                ? "Нет в наличии"
                : availableAmount <= 5
                    ? "Низкий остаток"
                    : "В наличии";
        }

        <div class="info-card">
            <div class="product-info-top">
                <div class="product-title-block">
                    <h3 class="product-title">@Model.Name</h3>

                    <div class="product-subtitle">
                        <span class="meta-badge">Артикул: @Model.ProductInfo.Article</span>
                    </div>
                </div>

                <span class="stock-badge @stockClass">
                    @stockText
                </span>
            </div>

            <div class="info-grid">
                <div class="info-block">
                    <div class="info-label">Цена в каталоге</div>
                    <div class="info-value">@Model.ProductInfo.Price</div>
                </div>

                <div class="info-block">
                    <div class="info-label">Размер</div>
                    <div class="info-value">@Model.ProductInfo.Size</div>
                </div>

                <div class="info-block">
                    <div class="info-label">Цвет</div>
                    <div class="info-value">@Model.ProductInfo.Color</div>
                </div>

                <div class="info-block">
                    <div class="info-label">Остаток на складе</div>
                    <div class="info-value">@Model.ProductInfo.Amount</div>
                </div>

                <div class="info-block" style="grid-column: 1 / -1;">
                    <div class="info-label">Расположение</div>
                    <div class="info-value">@Model.ProductInfo.Location</div>
                </div>
            </div>
        </div>

        <div class="form-card">
            <h3 class="form-title">Данные продажи</h3>

            <form asp-controller="Manager" asp-action="RegisterSale" method="post">
                <input asp-for="ProductInfo.Id" type="hidden" />
                <input asp-for="ProductInfo.ProductId" type="hidden" />
                <input asp-for="ProductInfo.Article" type="hidden" />
                <input asp-for="ProductInfo.Price" type="hidden" />
                <input asp-for="ProductInfo.Size" type="hidden" />
                <input asp-for="ProductInfo.Color" type="hidden" />
                <input asp-for="ProductInfo.Amount" type="hidden" />
                <input asp-for="ProductInfo.Location" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="sale-form">
                    <div class="form-group">
                        <label asp-for="Amount" class="form-label">Количество к продаже</label>
                        <input asp-for="Amount"
                               class="form-input"
                               type="number"
                               min="1"
                               max="@availableAmount"
                               placeholder="Введите количество" />
                        <span class="field-hint">Доступно на складе: @availableAmount шт.</span>
                        <span asp-validation-for="Amount" class="validation-text"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PricePerUnit" class="form-label">Цена за единицу</label>
                        <input asp-for="PricePerUnit"
                               class="form-input"
                               type="number"
                               step="0.01"
                               min="0.01"
                               placeholder="Введите цену" />
                        <span class="field-hint">Текущая рекомендованная цена: @Model.ProductInfo.Price</span>
                        <span asp-validation-for="PricePerUnit" class="validation-text"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="SaleDate" class="form-label">Дата и время продажи</label>
                        <input asp-for="SaleDate"
                               class="form-input"
                               type="datetime-local"
                               value="@defaultDate.ToString("yyyy-MM-ddTHH:mm")" />
                        <span class="field-hint">Укажите фактическое время совершения продажи.</span>
                        <span asp-validation-for="SaleDate" class="validation-text"></span>
                    </div>

                    <div class="form-group full-width">
                        <div class="readonly-note">
                            После регистрации продажи количество товара на складе будет уменьшено на указанное число единиц.
                        </div>
                    </div>
                </div>

                <div class="summary-box">
                    <div>
                        <div class="summary-title">Ожидаемая сумма продажи</div>
                        <div class="field-hint">Сумма рассчитывается как количество × цена за единицу.</div>
                    </div>

                    <div class="summary-value" id="saleTotalPreview">0</div>
                </div>

                <div class="form-actions">
                    <a asp-controller="Catalog"
                       asp-action="ProductInfos"
                       asp-route-productId="@Model.ProductInfo.ProductId"
                       class="secondary-btn">
                        Назад
                    </a>

                    <button type="submit"
                            class="primary-btn"
                            @(availableAmount <= 0 ? "disabled" : "")>
                        Зарегистрировать продажу
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const amountInput = document.getElementById("Amount");
            const priceInput = document.getElementById("PricePerUnit");
            const totalPreview = document.getElementById("saleTotalPreview");

            function updateTotal() {
                const amount = parseFloat(amountInput?.value || 0);
                const price = parseFloat(priceInput?.value || 0);
                const total = amount * price;

                if (!isNaN(total) && total > 0) {
                    totalPreview.textContent = total.toFixed(2);
                } else {
                    totalPreview.textContent = "0";
                }
            }

            if (amountInput) amountInput.addEventListener("input", updateTotal);
            if (priceInput) priceInput.addEventListener("input", updateTotal);

            updateTotal();
        })();
    </script>
}