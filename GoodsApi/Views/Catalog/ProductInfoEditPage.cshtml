@model GoodsApi.Infrastructure.ViewModels.ProductInfoEditViewModel

@{
    ViewBag.Title = Model.PageTitle;
    Layout = "_Layout";
}

<head>
    <style>
        .product-info-edit-page {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: #1f2937;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 16px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .page-header-left h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
            color: #111827;
        }

        .page-header-left p {
            margin-top: 10px;
            font-size: 15px;
            color: #6b7280;
            max-width: 760px;
            line-height: 1.6;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 150px;
            height: 46px;
            padding: 0 18px;
            border-radius: 14px;
            background: #f3f4f6;
            color: #111827;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            border: 1px solid #e5e7eb;
            transition: all 0.18s ease;
        }

        .back-btn:hover {
            background: #e5e7eb;
            transform: translateY(-2px);
        }

        .form-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 28px;
            padding: 30px;
            box-shadow: 0 14px 34px rgba(0, 0, 0, 0.05);
        }

        .form-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 26px;
        }

        .form-title {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-title h3 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            color: #111827;
        }

        .form-title p {
            margin: 0;
            font-size: 15px;
            color: #6b7280;
            line-height: 1.6;
        }

        .edit-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: fit-content;
            padding: 8px 14px;
            border-radius: 999px;
            background: #f9fafb;
            color: #6b7280;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .validation-summary-errors {
            margin-bottom: 22px;
            padding: 16px 18px;
            border-radius: 18px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            font-size: 14px;
            line-height: 1.6;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 22px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-label {
            font-size: 13px;
            font-weight: 700;
            color: #374151;
            letter-spacing: 0.02em;
        }

        .form-input,
        .form-select {
            width: 100%;
            height: 52px;
            padding: 0 16px;
            border-radius: 16px;
            border: 1px solid #d1d5db;
            background: #ffffff;
            font-size: 15px;
            color: #111827;
            outline: none;
            transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
            box-sizing: border-box;
        }

        .form-input:focus,
        .form-select:focus {
            border-color: #111827;
            box-shadow: 0 0 0 4px rgba(17, 24, 39, 0.08);
        }

        .form-input::placeholder {
            color: #9ca3af;
        }

        .field-validation-error {
            font-size: 13px;
            color: #dc2626;
            font-weight: 600;
            margin-top: 2px;
        }

        .form-hint {
            font-size: 13px;
            color: #6b7280;
            line-height: 1.5;
        }

        .form-actions {
            margin-top: 30px;
            display: flex;
            justify-content: flex-end;
            gap: 14px;
            flex-wrap: wrap;
        }

        .secondary-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 150px;
            height: 50px;
            padding: 0 18px;
            border-radius: 16px;
            background: #f3f4f6;
            color: #111827;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            border: 1px solid #e5e7eb;
            transition: all 0.18s ease;
        }

        .secondary-btn:hover {
            background: #e5e7eb;
            transform: translateY(-2px);
        }

        .primary-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 200px;
            height: 50px;
            padding: 0 22px;
            border-radius: 16px;
            background: #111827;
            color: #ffffff;
            font-weight: 700;
            font-size: 14px;
            border: none;
            cursor: pointer;
            transition: all 0.18s ease;
            box-shadow: 0 12px 26px rgba(17, 24, 39, 0.14);
        }

        .primary-btn:hover {
            background: #1f2937;
            transform: translateY(-2px);
            box-shadow: 0 16px 30px rgba(17, 24, 39, 0.20);
        }

        @@media (max-width: 768px) {
            .product-info-edit-page {
                margin: 24px auto;
                padding: 0 14px;
            }

            .page-header-left h2 {
                font-size: 28px;
            }

            .form-card {
                padding: 22px;
                border-radius: 22px;
            }

            .form-title h3 {
                font-size: 24px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .form-actions {
                justify-content: stretch;
            }

            .secondary-btn,
            .primary-btn,
            .back-btn {
                width: 100%;
            }
        }
    </style>
</head>

<div class="product-info-edit-page">
    <div class="page-header">
        <div class="page-header-left">
            <h2>@Model.PageTitle</h2>
            <p>
                @(Model.IsEdit
                    ? "Измените данные выбранного варианта товара, при необходимости перенесите его к другому товару и сохраните изменения."
                    : "Создайте новый вариант товара.")
            </p>
        </div>

        <a asp-controller="Catalog"
           asp-action="Products"
           class="back-btn">
            К каталогу товаров
        </a>
    </div>

    <div class="form-card">
        <div class="form-top">
            <div class="form-title">
                <h3>@(Model.IsEdit ? "Редактирование" : "Создание")</h3>
                <p>
                    @(Model.IsEdit
                        ? "Изменения вступят в силу после сохранения."
                        : "После создания новый вариант реализации появится в списке выбранного товара.")
                </p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly"></div>

        <form asp-controller="Catalog"
              asp-action="SaveProductInfo"
              method="post">
            <input asp-for="Id" type="hidden"/>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label asp-for="ProductId" class="form-label"></label>
                    <select asp-for="ProductId" asp-items="Model.Products" class="form-select">
                        <option value="">Выберите товар</option>
                    </select>
                    <span asp-validation-for="ProductId" class="field-validation-error"></span>
                    <div class="form-hint">
                        Здесь можно выбрать, к какому товару относится данный вариант.
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Article" class="form-label"></label>
                    <input asp-for="Article" class="form-input" placeholder="Например: NK-BLK-42"/>
                    <span asp-validation-for="Article" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-input"
                           placeholder="Например: 4999.99"/>
                    <span asp-validation-for="Price" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Size" class="form-label"></label>
                    <input asp-for="Size" type="number" step="0.01" min="0" class="form-input"
                           placeholder="Например: 42"/>
                    <span asp-validation-for="Size" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Color" class="form-label"></label>
                    <input asp-for="Color" class="form-input" placeholder="Например: Чёрный"/>
                    <span asp-validation-for="Color" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" type="number" min="0" class="form-input" placeholder="Например: 12"/>
                    <span asp-validation-for="Amount" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-input" placeholder="Например: Склад A / Стеллаж 4 / Полка 2"/>
                    <span asp-validation-for="Location" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-controller="Catalog"
                   asp-action="ProductInfos"
                   asp-route-productId="@Model.ProductId"
                   class="secondary-btn">
                    Отмена
                </a>

                <button type="submit" class="primary-btn">
                    @Model.SubmitButtonText
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}