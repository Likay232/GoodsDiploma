@model GoodsApi.Infrastructure.ViewModels.ProductRemainsViewModel

@{
    ViewBag.Title = "Остатки товаров";
    Layout = "_Layout";
}

<head>
    <style>
        .remains-page {
            max-width: 1300px;
            margin: 40px auto;
            padding: 0 20px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: #1f2937;
        }

        .remains-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 16px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }

        .remains-header-left h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
            color: #111827;
        }

        .remains-header-left p {
            margin-top: 10px;
            font-size: 15px;
            color: #6b7280;
        }

        .remains-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 0 16px;
            border-radius: 14px;
            background: #f3f4f6;
            color: #111827;
            font-size: 14px;
            font-weight: 600;
            border: 1px solid #e5e7eb;
        }

        .remains-list {
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        .remain-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 28px;
            padding: 28px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04);
            transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        }

        .remain-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 36px rgba(0, 0, 0, 0.07);
            border-color: #d1d5db;
        }

        .remain-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 18px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .remain-title-block {
            min-width: 0;
            flex: 1;
        }

        .remain-title {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            color: #111827;
            line-height: 1.25;
            word-break: break-word;
        }

        .remain-subtitle {
            margin-top: 10px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .meta-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 14px;
            border-radius: 999px;
            background: #f9fafb;
            color: #4b5563;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid #e5e7eb;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 10px 16px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
            border: 1px solid transparent;
        }

        .status-good {
            background: #ecfdf5;
            color: #047857;
            border-color: #a7f3d0;
        }

        .status-warning {
            background: #fffbeb;
            color: #b45309;
            border-color: #fde68a;
        }

        .status-danger {
            background: #fef2f2;
            color: #b91c1c;
            border-color: #fecaca;
        }

        .remain-info {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 26px;
        }

        .info-block {
            padding: 16px 18px;
            border-radius: 20px;
            background: #f9fafb;
            border: 1px solid #f3f4f6;
        }

        .info-label {
            font-size: 12px;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 8px;
        }

        .info-value {
            font-size: 17px;
            font-weight: 700;
            color: #111827;
            word-break: break-word;
            line-height: 1.45;
        }

        .remain-progress-section {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .progress-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .progress-title {
            font-size: 15px;
            font-weight: 700;
            color: #111827;
        }

        .progress-values {
            font-size: 14px;
            font-weight: 700;
            color: #4b5563;
        }

        .progress-track {
            position: relative;
            width: 100%;
            height: 22px;
            border-radius: 999px;
            overflow: hidden;
            background: #f3f4f6;
            display: flex;
            border: 1px solid #e5e7eb;
        }

        .segment-red {
            background: linear-gradient(90deg, #fca5a5 0%, #ef4444 100%);
            height: 100%;
        }

        .segment-yellow {
            background: linear-gradient(90deg, #fde68a 0%, #f59e0b 100%);
            height: 100%;
        }

        .segment-green {
            background: linear-gradient(90deg, #86efac 0%, #22c55e 100%);
            height: 100%;
        }

        .progress-marker {
            position: absolute;
            top: -4px;
            width: 4px;
            height: 30px;
            border-radius: 999px;
            background: #111827;
            box-shadow: 0 0 0 3px rgba(255,255,255,0.85);
            transform: translateX(-50%);
            z-index: 3;
        }

        .progress-scale {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            font-size: 12px;
            color: #6b7280;
            font-weight: 600;
        }

        .empty-state {
            margin-top: 24px;
            padding: 48px 28px;
            border-radius: 28px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            text-align: center;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04);
        }

        .empty-state h3 {
            margin: 0 0 12px 0;
            font-size: 24px;
            font-weight: 700;
            color: #111827;
        }

        .empty-state p {
            margin: 0;
            font-size: 15px;
            color: #6b7280;
            line-height: 1.6;
        }

        @@media (max-width: 992px) {
            .remain-info {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .remains-page {
                margin: 24px auto;
                padding: 0 14px;
            }

            .remains-header-left h2 {
                font-size: 28px;
            }

            .remain-card {
                padding: 22px 18px;
                border-radius: 22px;
            }

            .remain-title {
                font-size: 24px;
            }

            .remain-info {
                grid-template-columns: 1fr;
            }

            .progress-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<div class="remains-page">
    <div class="remains-header">
        <div class="remains-header-left">
            <h2>Остатки товаров</h2>
            <p>Контроль текущих остатков на складе и визуальное сравнение с минимально допустимым уровнем.</p>
        </div>

        <div class="remains-count">
            Всего позиций: @Model.ProductRemains.Count
        </div>
    </div>

    @if (Model.ProductRemains.Any())
    {
        <div class="remains-list">
            @foreach (var item in Model.ProductRemains)
            {
                var min = item.MinimumRemain <= 0 ? 1 : item.MinimumRemain;
                var greenStart = min * 2m;

                string statusText;
                string statusClass;

                if (item.TotalRemain < min)
                {
                    statusText = "Критически мало";
                    statusClass = "status-danger";
                }
                else if (item.TotalRemain < greenStart)
                {
                    statusText = "Низкий остаток";
                    statusClass = "status-warning";
                }
                else
                {
                    statusText = "Остаток в норме";
                    statusClass = "status-good";
                }

                // Визуальная шкала:
                // 0 -------- min -------- 2*min -------- 3*min
                // red       yellow        green
                var maxScale = Math.Max(greenStart * 1.5m, item.TotalRemain);
                if (maxScale <= 0) maxScale = 1;

                var redWidth = (min / maxScale) * 100m;
                var yellowWidth = ((greenStart - min) / maxScale) * 100m;
                var greenWidth = Math.Max(0, 100m - redWidth - yellowWidth);

                var markerPosition = (item.TotalRemain / maxScale) * 100m;
                if (markerPosition > 100) markerPosition = 100;
                if (markerPosition < 0) markerPosition = 0;

                <div class="remain-card">
                    <div class="remain-top">
                        <div class="remain-title-block">
                            <h3 class="remain-title">@item.Name</h3>

                            <div class="remain-subtitle">
                                <span class="meta-badge">ID товара: @item.ProductId</span>
                                <span class="meta-badge">@item.Category</span>
                                <span class="meta-badge">@item.Brand</span>
                                <span class="meta-badge">Размер: @item.Size</span>
                                <span class="meta-badge">Цвет: @item.Color</span>
                            </div>
                        </div>

                        <span class="status-badge @statusClass">
                            @statusText
                        </span>
                    </div>

                    <div class="remain-info">
                        <div class="info-block">
                            <div class="info-label">Минимальный остаток</div>
                            <div class="info-value">@item.MinimumRemain</div>
                        </div>

                        <div class="info-block">
                            <div class="info-label">Текущий остаток</div>
                            <div class="info-value">@item.TotalRemain</div>
                        </div>

                        <div class="info-block">
                            <div class="info-label">Запас относительно минимума</div>
                            <div class="info-value">
                                @(item.MinimumRemain > 0
                                    ? $"{Math.Round(item.TotalRemain / item.MinimumRemain, 2)}×"
                                    : "—")
                            </div>
                        </div>
                    </div>

                    <div class="remain-progress-section">
                        <div class="progress-header">
                            <div class="progress-title">Состояние складского остатка</div>
                            <div class="progress-values">
                                Остаток: @item.TotalRemain / Мин: @item.MinimumRemain
                            </div>
                        </div>

                        <div class="progress-track">
                            <div class="segment-red" style="width: @redWidth%;"></div>
                            <div class="segment-yellow" style="width: @yellowWidth%;"></div>
                            <div class="segment-green" style="width: @greenWidth%;"></div>

                            <div class="progress-marker" style="left: @markerPosition%;"></div>
                        </div>

                        <div class="progress-scale">
                            <span>0</span>
                            <span>Мин: @item.MinimumRemain</span>
                            <span>2× Мин: @greenStart</span>
                            <span>Текущий: @item.TotalRemain</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>Остатки пока отсутствуют</h3>
            <p>
                Нет данных по остаткам товаров на складе.
            </p>
        </div>
    }
</div>